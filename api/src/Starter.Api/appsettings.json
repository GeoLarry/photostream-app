{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=app.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "InitializeOnStartup": true
  },
  "Jwt": {
    "Secret": "CHANGE_ME_set_a_random_secret_of_at_least_32_characters",
    "Issuer": "Starter.Api",
    "Audience": "Starter.Client",
    "ExpiryMinutes": 10080
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminEmail": "admin@example.com",
    "AdminPassword": "",
    "DemoUsers": 0
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseSsl": false,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@photostream.local",
    "FromName": "Photostream"
  },
  "EmailConfirmation": {
    "TokenLifetimeHours": 24,
    "ResendCooldownSeconds": 60
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowMinutes": 15
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
